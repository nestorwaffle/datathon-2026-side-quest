# ==============================================================================
# Plantilla de Variables de Entorno - Observabilidad con RawTree y OpenTelemetry
# ==============================================================================

# RawTree Telemetry & OLAP Database
RAWTREE_API_KEY=
RAWTREE_READ_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=datathon_mathops
DEVFLIGHT_SOURCE_NAME=RawTree compartido

# Configuración del Colector Local DevFlight
DEVFLIGHT_HOME=.devflight
DEVFLIGHT_OFFLINE=0
DEVFLIGHT_HTTP_TOKEN=
DEVFLIGHT_DEVELOPER_ID=
DEVFLIGHT_SESSION_ID=
DEVFLIGHT_CAPTURE_PROFILE=essential
# Maximum bytes of telemetry JSONL/gzip files; 0 preserves unlimited history.
# At capacity new requests receive retryable 503; no historical files are deleted.
DEVFLIGHT_MAX_QUEUE_BYTES=0

# Enterprise API and Helmcode (private values belong only in .env/environment)
DEVFLIGHT_PLATFORM_HOME=.devflight/platform
DEVFLIGHT_PLATFORM_MAX_BYTES=536870912
HELMCODE_API_KEY=
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_MODEL=qwen3.6
DEVFLIGHT_ANALYST_OUTPUT_TOKENS=512
DEVFLIGHT_ANALYST_MAX_ITERATIONS=3
DEVFLIGHT_ANALYST_MAX_QUERIES=4
DEVFLIGHT_ANALYST_TOTAL_TOKENS=6000
DEVFLIGHT_ANALYST_TIMEOUT=60

# Configuración OpenTelemetry
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:8787

# Endpoints locales de modelo para pruebas offline (loopback)
LLAMA_URL=http://127.0.0.1:8080/v1/chat/completions
EMBEDDING_URL=http://127.0.0.1:8081/v1/embeddings
